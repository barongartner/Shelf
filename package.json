{
  "name": "shelf",
  "productName": "Shelf",
  "version": "1.1.0",
  "description": "A file shelf shared by your computers and your phone, on your own network.",
  "author": "Baron Gartner <barongartner@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/barongartner/Shelf",
  "repository": "github:barongartner/Shelf",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "two": "node scripts/two.js",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "node-forge": "1.4.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.barongartner.shelf",
    "productName": "Shelf",
    "copyright": "Copyright © 2026 Baron Gartner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "artifactName": "Shelf-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSLocalNetworkUsageDescription": "Shelf finds your other computers on this network and sends files between them.",
        "NSBonjourServices": [
          "_shelf._tcp"
        ]
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Shelf-${version}-mac-${arch}.dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Shelf-Setup-${version}.exe",
      "shortcutName": "Shelf"
    },
    "portable": {
      "artifactName": "Shelf-${version}-portable.exe"
    }
  }
}
